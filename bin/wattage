#!/usr/bin/env python3
"""wattage - not how much battery is left, but what ate it.

Every battery widget reports the same number the kernel already knows. This one
answers the question people actually ask at 3pm: what is draining this thing?

There is no per-process power meter in any laptop. What there is: the battery's
own reported draw, which is ground truth for the whole machine, and per-process
CPU time. Battery Watt Usage samples both and divides the machine's *active* draw between
processes in proportion to the CPU they burned, leaving the idle floor
unattributed. That is an estimate, and the UI says so -- but it is an estimate
built on a real measurement, and it is enough to find the process costing you
an hour of runtime.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import sqlite3
import stat
import subprocess
import tempfile
import sys
import time
from pathlib import Path

HOME = Path.home()
PLUGIN_DIR = Path(__file__).resolve().parent.parent
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "omarchy" / "wattage"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "omarchy"

SETTINGS_FILE = CONFIG_DIR / "settings.json"
DB_FILE = Path(os.environ.get("WATTAGE_DB") or (STATE_DIR / "wattage.db"))
STATE_FILE = STATE_DIR / "wattage.json"

CLK_TCK = os.sysconf("SC_CLK_TCK")
RETAIN_DAYS = 14

DEFAULT_SETTINGS = {
    "interval": 20,          # seconds between samples
    "idleWatts": 0.0,        # learned floor; 0 means "not learned yet"
    "wattsPerCpuSecond": 0.0,  # learned, used to estimate while on AC
    "quiet": {
        "auto": False,        # quieten automatically on battery
        "belowPercent": 100,  # ...when the battery is at or below this
        "plugins": [],        # bar plugin ids to disable
        # Anything else that can be turned down and back up again. Whole
        # plugins are a blunt instrument: the expensive thing is often one
        # setting inside one of them, like an animated wallpaper's rain.
        "commands": [],       # [{"off": "...", "on": "...", "label": "..."}]
    },
}


def ensure_config() -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if not SETTINGS_FILE.exists():
        save_settings(dict(DEFAULT_SETTINGS))

# Kernel threads have an empty /proc/<pid>/cmdline. They are the machine
# breathing rather than anything a person started, and left in they crowd the
# list with rcu_preempt and napi/phy0-0 instead of answering the question.
def is_kernel_thread(proc_dir: Path) -> bool:
    try:
        return (proc_dir / "cmdline").read_bytes().strip(b"\x00") == b""
    except OSError:
        return True


# ---------------------------------------------------------------- utilities

def atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def load_json(path: Path, fallback):
    try:
        return json.loads(path.read_text())
    except Exception:
        return fallback


def settings() -> dict:
    s = json.loads(json.dumps(DEFAULT_SETTINGS))
    user = load_json(SETTINGS_FILE, {}) or {}
    for key, value in user.items():
        if isinstance(value, dict) and isinstance(s.get(key), dict):
            s[key].update(value)
        else:
            s[key] = value
    return s


def save_settings(s: dict) -> None:
    atomic_write(SETTINGS_FILE, json.dumps(s, indent=2) + "\n")


def human_watts(w: float) -> str:
    if w is None:
        return "--"
    return f"{w:.1f} W" if w >= 1 else f"{w * 1000:.0f} mW"


def human_energy(mwh: float) -> str:
    if mwh >= 1000:
        return f"{mwh / 1000:.2f} Wh"
    return f"{mwh:.0f} mWh"


SYSTEMD_ESCAPE = re.compile(r"\\x([0-9a-fA-F]{2})")
# Trailing instance ids systemd appends: -1326, -ec06e741, -94b95655.
INSTANCE_SUFFIX = re.compile(r"-(?:[0-9]+|[0-9a-f]{6,})$")
# Per-window scopes some apps create: ghostty-surface-transient-135447.
WINDOW_SUFFIX = re.compile(r"^(.+?)-(?:surface|transient|window|tab)\b")
# Launchers that prefix the scope with their own name.
LAUNCHER_PREFIXES = ("Hyprland-", "uwsm-", "app-daemon-")


def app_from_cgroup(cgroup: str) -> str | None:
    """The app a cgroup path belongs to, or None if it does not name one.

    Real examples this has to survive, all taken from a running machine:

        app-ghostty-surface-transient-135447.scope   -> ghostty
        app-Hyprland-brave-ec06e741.scope            -> brave
        app-Hyprland-xdg\\x2dterminal\\x2dexec-94b9.scope -> xdg-terminal-exec
        app-org.chromium.Chromium-2053133.scope      -> Chromium
        app-1password@autostart.service              -> 1password
        wayland-wm@hyprland.desktop.service          -> None (use comm)
    """
    leaf = cgroup.strip().split("/")[-1]
    leaf = leaf.replace(" (deleted)", "").strip()
    leaf = SYSTEMD_ESCAPE.sub(lambda m: chr(int(m.group(1), 16)), leaf)
    if not leaf.startswith("app-"):
        return None
    name = leaf[4:]
    for suffix in (".scope", ".service", ".slice"):
        if name.endswith(suffix):
            name = name[: -len(suffix)]
    name = name.split("@", 1)[0]          # 1password@autostart
    for prefix in LAUNCHER_PREFIXES:
        if name.startswith(prefix):
            name = name[len(prefix):]
    name = INSTANCE_SUFFIX.sub("", name)
    m = WINDOW_SUFFIX.match(name)
    if m:
        name = m.group(1)
    if "." in name and not name.startswith("."):
        # org.chromium.Chromium -> Chromium
        tail = name.rsplit(".", 1)[-1]
        if tail:
            name = tail
    return name or None


# ---------------------------------------------------------------- the system

class System:
    """Everything read from the machine, in one place so tests can
    substitute a fake one."""

    def __init__(self, proc="/proc", power_supply="/sys/class/power_supply"):
        self.proc = Path(proc)
        self.power_supply = Path(power_supply)

    # ---- cpu

    def cpu_total_jiffies(self) -> tuple[int, int]:
        """(busy, total) jiffies across all cores."""
        line = (self.proc / "stat").read_text().splitlines()[0]
        parts = [int(x) for x in line.split()[1:]]
        idle = parts[3] + (parts[4] if len(parts) > 4 else 0)   # idle + iowait
        total = sum(parts)
        return total - idle, total

    def processes(self) -> dict[int, tuple[str, int]]:
        """pid -> (app name, cpu jiffies used so far)."""
        out = {}
        for entry in self.proc.iterdir():
            if not entry.name.isdigit():
                continue
            pid = int(entry.name)
            if is_kernel_thread(entry):
                continue
            try:
                stat = (entry / "stat").read_text()
            except (OSError, UnicodeDecodeError):
                continue
            # comm can contain spaces and parentheses, so split on the last ')'
            close = stat.rfind(")")
            open_paren = stat.find("(")
            if close < 0 or open_paren < 0:
                continue
            comm = stat[open_paren + 1:close]
            fields = stat[close + 2:].split()
            if len(fields) < 13:
                continue
            try:
                jiffies = int(fields[11]) + int(fields[12])   # utime + stime
            except ValueError:
                continue
            out[pid] = (self.app_name(pid, comm), jiffies)
        return out

    def app_name(self, pid: int, comm: str) -> str:
        """Group by the systemd scope when there is one: that is the unit a
        person recognises ("ghostty"), where comm is often a helper thread."""
        try:
            cgroup = (self.proc / str(pid) / "cgroup").read_text().strip()
        except OSError:
            return comm
        return app_from_cgroup(cgroup) or comm

    # ---- power

    def batteries(self):
        if not self.power_supply.exists():
            return []
        return sorted(
            p for p in self.power_supply.iterdir()
            if (p / "type").exists() and (p / "type").read_text().strip() == "Battery"
            and (p / "status").exists()
        )

    def _read_int(self, path: Path):
        try:
            return int(path.read_text().strip())
        except (OSError, ValueError):
            return None

    def power(self) -> dict:
        """Watts the machine is drawing, and whether that number is real.

        `power_now` is only meaningful while discharging; on AC most firmware
        reports zero, which is not the same as using no power.
        """
        for bat in self.batteries():
            status = (bat / "status").read_text().strip()
            uw = self._read_int(bat / "power_now")
            if uw is None:
                current = self._read_int(bat / "current_now")
                voltage = self._read_int(bat / "voltage_now")
                if current is not None and voltage is not None:
                    uw = abs(current) * voltage // 1_000_000
            energy = self._read_int(bat / "energy_now")
            full = self._read_int(bat / "energy_full")
            capacity = self._read_int(bat / "capacity")
            discharging = status == "Discharging"
            watts = (abs(uw) / 1_000_000) if uw else 0.0
            return {
                "battery": bat.name,
                "status": status,
                "discharging": discharging,
                "watts": watts if discharging and watts > 0 else None,
                "measured": bool(discharging and watts > 0),
                "percent": capacity,
                "energy_mwh": (energy / 1000) if energy else None,
                "full_mwh": (full / 1000) if full else None,
            }
        return {"battery": None, "status": "unknown", "discharging": False,
                "watts": None, "measured": False, "percent": None,
                "energy_mwh": None, "full_mwh": None}


# ---------------------------------------------------------------- storage

SCHEMA = """
CREATE TABLE IF NOT EXISTS samples (
  ts REAL PRIMARY KEY,
  seconds REAL NOT NULL,
  watts REAL,
  measured INTEGER NOT NULL,
  discharging INTEGER NOT NULL,
  percent INTEGER,
  busy_cpu REAL NOT NULL
);
CREATE TABLE IF NOT EXISTS usage (
  ts REAL NOT NULL,
  app TEXT NOT NULL,
  cpu_seconds REAL NOT NULL,
  mwh REAL NOT NULL,
  PRIMARY KEY (ts, app)
);
CREATE INDEX IF NOT EXISTS usage_ts ON usage (ts);
CREATE TABLE IF NOT EXISTS plugin_cost (
  id TEXT PRIMARY KEY,
  cpu_delta REAL NOT NULL,     -- shell CPU-seconds attributable, per second
  on_cpu REAL NOT NULL,
  off_cpu REAL NOT NULL,
  seconds REAL NOT NULL,
  measured_at REAL NOT NULL
);
CREATE TABLE IF NOT EXISTS cursor (
  id INTEGER PRIMARY KEY CHECK (id = 1),
  ts REAL, busy INTEGER, total INTEGER, pids TEXT
);
"""


def db() -> sqlite3.Connection:
    DB_FILE.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_FILE, timeout=10)
    conn.executescript(SCHEMA)
    return conn


def prune(conn) -> None:
    cutoff = time.time() - RETAIN_DAYS * 86400
    conn.execute("DELETE FROM usage WHERE ts < ?", (cutoff,))
    conn.execute("DELETE FROM samples WHERE ts < ?", (cutoff,))


# ---------------------------------------------------------------- sampling

def attribute(prev_pids, now_pids, active_watts, seconds):
    """Split active watts between apps in proportion to CPU burned.

    A process that appeared since the last sample contributes only the CPU it
    has used, and one that exited contributes nothing -- short-lived processes
    are the known blind spot of any sampling approach, and pretending otherwise
    would be worse than saying it.
    """
    per_app: dict[str, float] = {}
    for pid, (app, jiffies) in now_pids.items():
        before = prev_pids.get(pid)
        if before is None:
            continue
        prev_app, prev_jiffies = before
        delta = jiffies - prev_jiffies
        if delta <= 0:
            continue
        per_app[app] = per_app.get(app, 0.0) + delta / CLK_TCK

    total_cpu = sum(per_app.values())
    rows = []
    for app, cpu_s in per_app.items():
        share = (cpu_s / total_cpu) if total_cpu > 0 else 0.0
        watts = (active_watts or 0.0) * share
        mwh = watts * (seconds / 3600.0) * 1000.0
        rows.append((app, cpu_s, mwh))
    return rows, total_cpu


def sample_once(system: System, conn, now: float | None = None) -> dict:
    s = settings()
    now = now if now is not None else time.time()
    busy, total = system.cpu_total_jiffies()
    pids = system.processes()
    power = system.power()

    row = conn.execute("SELECT ts, busy, total, pids FROM cursor WHERE id = 1").fetchone()
    conn.execute(
        "INSERT OR REPLACE INTO cursor (id, ts, busy, total, pids) VALUES (1, ?, ?, ?, ?)",
        (now, busy, total, json.dumps({str(p): v for p, v in pids.items()})),
    )

    if row is None:
        conn.commit()
        return {"first": True, **power}

    prev_ts, prev_busy, prev_total, prev_pids_json = row
    seconds = now - prev_ts
    if seconds <= 0 or seconds > 3600:
        # A suspend, a clock jump, or a stale cursor: start again rather than
        # attributing hours of drain to whatever happened to be running.
        conn.commit()
        return {"reset": True, **power}

    prev_pids = {int(k): tuple(v) for k, v in json.loads(prev_pids_json).items()}

    # Learn the idle floor and the cost of a CPU-second while we can measure.
    idle_watts = float(s.get("idleWatts") or 0.0)
    watts = power["watts"]
    busy_cpu_seconds = max(0.0, (busy - prev_busy) / CLK_TCK)

    if power["measured"] and watts:
        if busy_cpu_seconds / max(seconds, 1e-9) < 0.05:
            # Nearly idle: this reading is a good estimate of the floor.
            idle_watts = watts if idle_watts <= 0 else min(idle_watts, watts)
            s["idleWatts"] = round(idle_watts, 3)
            save_settings(s)
        elif busy_cpu_seconds > 0 and idle_watts > 0:
            per_cpu = max(0.0, watts - idle_watts) / busy_cpu_seconds
            learned = float(s.get("wattsPerCpuSecond") or 0.0)
            s["wattsPerCpuSecond"] = round(
                per_cpu if learned <= 0 else (learned * 0.8 + per_cpu * 0.2), 3)
            save_settings(s)
        active = max(0.0, watts - idle_watts)
    else:
        # On AC there is no measurement to divide up. Fall back to what the
        # machine taught us while it was on battery, and mark it estimated.
        per_cpu = float(s.get("wattsPerCpuSecond") or 0.0)
        active = per_cpu * busy_cpu_seconds if per_cpu > 0 else 0.0

    rows, total_cpu = attribute(prev_pids, pids, active, seconds)

    conn.execute(
        "INSERT OR REPLACE INTO samples (ts, seconds, watts, measured, discharging, percent, busy_cpu)"
        " VALUES (?, ?, ?, ?, ?, ?, ?)",
        (now, seconds, watts, int(power["measured"]), int(power["discharging"]),
         power["percent"], total_cpu),
    )
    for app, cpu_s, mwh in rows:
        conn.execute(
            "INSERT OR REPLACE INTO usage (ts, app, cpu_seconds, mwh) VALUES (?, ?, ?, ?)",
            (now, app, cpu_s, mwh))
    prune(conn)
    conn.commit()

    top = sorted(rows, key=lambda r: (-r[2], -r[1]))[:5]
    result = {
        "seconds": round(seconds, 1),
        "active_watts": round(active, 2),
        "total_cpu_seconds": round(total_cpu, 2),
        "top": [{"app": a, "cpu_seconds": round(c, 2), "mwh": round(m, 2)} for a, c, m in top],
        **power,
    }
    write_state(result, top)
    return result


def write_state(result: dict, top) -> None:
    atomic_write(STATE_FILE, json.dumps({
        "watts": result.get("watts"),
        "measured": result.get("measured"),
        "discharging": result.get("discharging"),
        "percent": result.get("percent"),
        "status": result.get("status"),
        "top": [{"app": a, "mwh": round(m, 2)} for a, _c, m in top],
        "quiet": quiet_active(),
        "quietConfigured": quiet_configured(),
        "at": time.time(),
    }, indent=2) + "\n")


# ---------------------------------------------------------------- quiet mode

QUIET_MARKER = STATE_DIR / "wattage-quiet.json"


def quiet_active() -> bool:
    return QUIET_MARKER.exists()


def quiet_targets(s: dict | None = None) -> tuple[list, list]:
    s = s or settings()
    cfg = s.get("quiet", {}) or {}
    plugins = [p for p in (cfg.get("plugins") or []) if p]
    commands = [c for c in (cfg.get("commands") or []) if isinstance(c, dict) and c.get("off")]
    return plugins, commands


def quiet_configured() -> bool:
    plugins, commands = quiet_targets()
    return bool(plugins or commands)


def plugin_ids() -> list[str]:
    try:
        out = subprocess.run(["omarchy", "plugin", "list", "--json"],
                             capture_output=True, text=True, timeout=15).stdout
        return [p.get("id") for p in json.loads(out) if p.get("id")]
    except Exception:
        return []


def set_quiet(on: bool) -> list[str]:
    """Turn the nominated things down, and remember exactly what was turned
    down so the same things come back up -- even if the config changes in
    between, or the machine dies with quiet mode still on."""
    plugins, commands = quiet_targets()
    touched = []
    if on:
        if quiet_active():
            return []
        for pid in plugins:
            r = subprocess.run(["omarchy", "plugin", "disable", pid],
                               capture_output=True, text=True)
            if r.returncode == 0:
                touched.append(pid)
        ran = []
        for entry in commands:
            try:
                r = subprocess.run(shlex.split(entry["off"]), capture_output=True,
                                   text=True, timeout=20)
            except (OSError, ValueError, subprocess.SubprocessError) as exc:
                print(f"wattage: quiet off {entry['off']!r}: {exc}", file=sys.stderr)
                continue
            if r.returncode == 0:
                ran.append(entry)
                touched.append(entry.get("label") or entry["off"])
            else:
                print(f"wattage: quiet off {entry['off']!r} exited {r.returncode}:"
                      f" {(r.stderr or '').strip()[:120]}", file=sys.stderr)
        atomic_write(QUIET_MARKER, json.dumps(
            {"disabled": [p for p in touched if p in plugins],
             "commands": ran, "at": time.time()}, indent=2))
    else:
        record = load_json(QUIET_MARKER, {}) or {}
        for pid in record.get("disabled", []):
            r = subprocess.run(["omarchy", "plugin", "enable", pid],
                               capture_output=True, text=True)
            if r.returncode == 0:
                touched.append(pid)
        for entry in record.get("commands", []):
            if not entry.get("on"):
                continue
            try:
                r = subprocess.run(shlex.split(entry["on"]), capture_output=True,
                                   text=True, timeout=20)
            except (OSError, ValueError, subprocess.SubprocessError) as exc:
                print(f"wattage: quiet on {entry['on']!r}: {exc}", file=sys.stderr)
                continue
            if r.returncode == 0:
                touched.append(entry.get("label") or entry["on"])
            else:
                print(f"wattage: quiet on {entry['on']!r} exited {r.returncode}:"
                      f" {(r.stderr or '').strip()[:120]}", file=sys.stderr)
        try:
            QUIET_MARKER.unlink()
        except OSError:
            pass
    return touched


# ---------------------------------------------------------------- reporting

WINDOWS = {"1h": 3600, "6h": 21600, "24h": 86400, "today": None, "7d": 604800, "14d": 1209600}


def window_start(name: str) -> float:
    if name == "today":
        t = time.localtime()
        return time.mktime((t.tm_year, t.tm_mon, t.tm_mday, 0, 0, 0, 0, 0, -1))
    return time.time() - WINDOWS.get(name, 86400)


def report(conn, since: float):
    rows = conn.execute(
        "SELECT app, SUM(mwh), SUM(cpu_seconds) FROM usage WHERE ts >= ?"
        " GROUP BY app ORDER BY SUM(mwh) DESC, SUM(cpu_seconds) DESC", (since,)).fetchall()
    meta = conn.execute(
        "SELECT SUM(seconds), SUM(CASE WHEN measured THEN seconds ELSE 0 END),"
        " AVG(CASE WHEN measured THEN watts END) FROM samples WHERE ts >= ?",
        (since,)).fetchone()
    covered, measured, avg_watts = (meta or (0, 0, None))
    return rows, {"covered": covered or 0, "measured": measured or 0, "avg_watts": avg_watts}


# ---------------------------------------------------------------- commands

def cmd_sample(args) -> int:
    ensure_config()
    system = System()
    conn = db()
    if not args.daemon:
        result = sample_once(system, conn)
        print(json.dumps(result, indent=2) if args.json else format_now(result))
        return 0
    # If quiet mode was left on and we are no longer on battery -- a crash, a
    # reboot, a kill -9 -- put everything back before doing anything else.
    if quiet_active() and not system.power()["discharging"]:
        restored = set_quiet(False)
        if restored:
            print(f"wattage: restored {len(restored)} item(s) left quietened",
                  file=sys.stderr)
    interval = int(settings().get("interval", 20))
    while True:
        try:
            sample_once(system, conn)
            maybe_auto_quiet(system)
        except Exception as exc:
            print(f"wattage: {exc}", file=sys.stderr)
        time.sleep(interval)


def maybe_auto_quiet(system: System) -> None:
    s = settings()
    cfg = s.get("quiet", {})
    if not cfg.get("auto"):
        return
    power = system.power()
    should = bool(power["discharging"]) and (power["percent"] or 100) <= int(
        cfg.get("belowPercent", 100))
    if should and not quiet_active():
        set_quiet(True)
    elif not should and quiet_active():
        set_quiet(False)


def format_now(result: dict) -> str:
    if result.get("first"):
        return "First sample taken; run again for attribution."
    lines = []
    if result.get("measured"):
        lines.append(f"Drawing {human_watts(result['watts'])} on battery"
                     f" ({result.get('percent')}%)")
    else:
        lines.append(f"On AC ({str(result.get('status', 'unknown')).lower()})"
                     f" - draw is estimated from CPU, not measured")
    for entry in result.get("top", []):
        lines.append(f"  {entry['app']:<24} {human_energy(entry['mwh']):>10}"
                     f"   {entry['cpu_seconds']:.1f}s cpu")
    return "\n".join(lines)


def cmd_now(args) -> int:
    state = load_json(STATE_FILE, {}) or {}
    if args.json:
        print(json.dumps(state, indent=2))
        return 0
    if not state:
        print("No samples yet - run: wattage sample")
        return 1
    if state.get("measured"):
        print(f"Drawing {human_watts(state['watts'])} ({state.get('percent')}%)")
    else:
        print(f"On AC ({str(state.get('status', 'unknown')).lower()})"
              f" - draw estimated from CPU")
    for entry in state.get("top", [])[:5]:
        print(f"  {entry['app']:<24} {human_energy(entry['mwh']):>10}")
    return 0


def cmd_top(args) -> int:
    conn = db()
    since = window_start(args.since)
    rows, meta = report(conn, since)
    if args.json:
        print(json.dumps({
            "since": args.since,
            "covered_seconds": meta["covered"],
            "measured_seconds": meta["measured"],
            "average_watts": meta["avg_watts"],
            "apps": [{"app": a, "mwh": round(m, 2), "cpu_seconds": round(c, 1)}
                     for a, m, c in rows],
        }, indent=2))
        return 0
    if not rows:
        print(f"Nothing recorded in the last {args.since}. Is the sampler running?")
        print("  wattage sample --daemon &   (or install the systemd timer: wattage service install)")
        return 1

    hours = meta["covered"] / 3600 if meta["covered"] else 0
    total = sum(m for _a, m, _c in rows)

    def duration(h):
        if h >= 1:
            return f"{h:.1f}h"
        return f"{h * 60:.0f}m" if h * 60 >= 1 else f"{h * 3600:.0f}s"

    print(f"\nWhere the power went - last {args.since}"
          f"  ({duration(hours)} sampled, {duration(meta['measured'] / 3600)} on battery)")
    if meta["avg_watts"]:
        print(f"Average draw while on battery: {human_watts(meta['avg_watts'])}")
    print()

    # With no measured draw there is nothing to divide up, and a column of
    # zeros reads as a broken tool. Rank by the thing that was measured.
    by_energy = total > 0
    if not by_energy:
        rows = sorted(rows, key=lambda r: -r[2])
        print("  No battery draw measured yet, so this is CPU time, not energy.")
        print("  Unplug for a few minutes and Battery Watt Usage learns what a CPU-second costs.")
        print()

    width = max((len(a) for a, _m, _c in rows[:args.limit]), default=10)
    peak_cpu = max((c for _a, _m, c in rows[:args.limit]), default=0) or 1
    for app, mwh, cpu_s in rows[:args.limit]:
        if by_energy:
            share = (mwh / total * 100) if total else 0
            bar = "\u2588" * max(0, int(share / 3))
            print(f"  {app:<{width}}  {human_energy(mwh):>9}  {share:5.1f}%  {bar} {cpu_s:.0f}s cpu")
        else:
            bar = "\u2588" * max(0, int(cpu_s / peak_cpu * 24))
            print(f"  {app:<{width}}  {cpu_s:8.1f}s cpu  {bar}")
    print()
    if by_energy and meta["measured"] < meta["covered"]:
        print("  Figures for time on AC are estimated from CPU use; only time on")
        print("  battery is measured. Attribution is by CPU share of active draw.")
        print()
    return 0


SETTLE = 5.0   # let the shell finish restarting before believing its CPU


def measure_plugin(plugin: str, seconds: int, quiet: bool = False):
    """Shell CPU with the widget on, and with it off. Restores it either way.

    Every Omarchy bar widget runs inside the one shell process, so no amount
    of per-process accounting can separate them. Turning one off and looking
    can. It is slow and it makes the bar flicker, which is why the result is
    written down rather than measured again every time you ask.
    """
    disabled = False
    try:
        time.sleep(SETTLE)
        on_cpu = measure_shell_cpu(seconds)
        r = subprocess.run(["omarchy", "plugin", "disable", plugin],
                           capture_output=True, text=True)
        if r.returncode != 0:
            raise RuntimeError((r.stderr or r.stdout or "disable failed").strip())
        disabled = True
        time.sleep(SETTLE)
        off_cpu = measure_shell_cpu(seconds)
    finally:
        if disabled:
            # Put it back even on Ctrl-C: leaving someone's bar missing a
            # widget because they interrupted a measurement is unacceptable.
            subprocess.run(["omarchy", "plugin", "enable", plugin],
                           capture_output=True, text=True)
            time.sleep(1)
    return on_cpu, off_cpu


def record_cost(plugin: str, on_cpu: float, off_cpu: float, seconds: int) -> None:
    conn = db()
    conn.execute(
        "INSERT OR REPLACE INTO plugin_cost"
        " (id, cpu_delta, on_cpu, off_cpu, seconds, measured_at) VALUES (?, ?, ?, ?, ?, ?)",
        (plugin, (on_cpu - off_cpu) / max(seconds, 1e-9), on_cpu, off_cpu,
         seconds, time.time()))
    conn.commit()


def noise_floor(seconds: int) -> float:
    """Below this a difference is not worth reporting as a difference."""
    return 0.02          # CPU-seconds per second, i.e. 2% of a core


def cmd_bisect(args) -> int:
    if shell_pid() is None:
        print("omarchy-shell is not running", file=sys.stderr)
        return 1
    seconds = args.seconds
    print(f"Measuring {args.plugin} over about {seconds * 2 + SETTLE * 2:.0f}s"
          f" (the bar will flicker twice)...")
    try:
        on_cpu, off_cpu = measure_plugin(args.plugin, seconds)
    except RuntimeError as exc:
        print(f"wattage: {exc}", file=sys.stderr)
        return 1
    record_cost(args.plugin, on_cpu, off_cpu, seconds)

    share = (on_cpu - off_cpu) / seconds
    print(f"\n  shell CPU with {args.plugin} on:  {on_cpu:.2f}s per {seconds}s")
    print(f"  shell CPU with it off:            {off_cpu:.2f}s per {seconds}s")
    print(f"  attributable to the widget:       {share * 100:+.1f}% of a core")
    print(f"  {describe_cost(share)}")
    return 0


def describe_cost(share: float) -> str:
    """Say what a CPU share means in a unit anyone cares about."""
    per_cpu = float(settings().get("wattsPerCpuSecond") or 0.0)
    if abs(share) < noise_floor(0):
        return "within noise - this widget is not what is draining you"
    hourly = share * 3600
    if per_cpu > 0:
        return (f"about {human_watts(abs(share * per_cpu))}"
                f" ({hourly:.0f} CPU-seconds an hour)")
    return (f"{hourly:.0f} CPU-seconds an hour"
            " (run on battery a while to turn that into watts)")


def cmd_plugins(args) -> int:
    """What each bar widget costs. Measured once, then just read back."""
    conn = db()

    if args.measure:
        widgets = [w.get("id") for w in bar_widgets() if w.get("id")]
        if args.only:
            widgets = [w for w in widgets if w in args.only]
        if not widgets:
            print("No enabled bar widgets found.", file=sys.stderr)
            return 1
        each = args.seconds * 2 + SETTLE * 2 + 1
        total = len(widgets) * each
        print(f"\nMeasuring {len(widgets)} widgets, about {total / 60:.0f} minutes.")
        print("Each one is switched off and back on, so the bar will flicker")
        print("throughout. Ctrl-C is safe: whatever is off gets switched back on.\n")
        if not args.yes and sys.stdin.isatty():
            if input("Go ahead? [y/N] ").strip().lower() not in ("y", "yes"):
                return 1
        for i, plugin in enumerate(widgets, 1):
            print(f"  [{i}/{len(widgets)}] {plugin} ... ", end="", flush=True)
            try:
                on_cpu, off_cpu = measure_plugin(plugin, args.seconds)
            except (RuntimeError, KeyboardInterrupt) as exc:
                print(f"skipped ({exc or 'interrupted'})")
                if isinstance(exc, KeyboardInterrupt):
                    return 130
                continue
            record_cost(plugin, on_cpu, off_cpu, args.seconds)
            share = (on_cpu - off_cpu) / args.seconds
            print(f"{share * 100:+.1f}% of a core")
        print()

    rows = conn.execute(
        "SELECT id, cpu_delta, seconds, measured_at FROM plugin_cost"
        " ORDER BY cpu_delta DESC").fetchall()
    if args.json:
        print(json.dumps([
            {"id": r[0], "core_share": round(r[1], 4),
             "cpu_seconds_per_hour": round(r[1] * 3600, 1),
             "sample_seconds": r[2], "measured_at": r[3]} for r in rows], indent=2))
        return 0
    if not rows:
        print("\nNo widget has been measured yet.\n")
        print("  Every bar widget runs inside one Quickshell process, so the only")
        print("  way to tell them apart is to switch one off and look. That is")
        print("  slow and it makes the bar flicker, so it is not done behind your")
        print("  back:\n")
        print("      wattage plugins --measure        # all enabled widgets")
        print("      wattage bisect <plugin-id>       # just one\n")
        return 1

    print("\nWhat each bar widget costs the shell\n")
    width = max(len(r[0]) for r in rows)
    peak = max((abs(r[1]) for r in rows), default=0) or 1
    for pid, share, _sec, at in rows:
        bar = "\u2588" * max(0, int(abs(share) / peak * 22))
        note = "" if abs(share) >= noise_floor(0) else "  (noise)"
        age = (time.time() - at) / 86400
        stale = f"  {age:.0f}d ago" if age >= 1 else ""
        print(f"  {pid:<{width}}  {share * 100:+6.1f}% of a core  {bar}{note}{stale}")
    print()
    per_cpu = float(settings().get("wattsPerCpuSecond") or 0.0)
    total = sum(r[1] for r in rows if r[1] > 0)
    print(f"  Everything measurable adds up to {total * 100:.0f}% of a core"
          + (f", about {human_watts(total * per_cpu)}" if per_cpu > 0 else "") + ".")
    print("  Anything not listed has not been measured yet.\n")
    return 0


def helper_processes(ps_output: str | None = None) -> list[dict]:
    """Long-lived processes the shell spawned, which some widget is paying for.

    Not attribution -- most children do not name the plugin that started them
    -- but it does surface the ones that leak, which is worth knowing.
    """
    if ps_output is None:
        pid = shell_pid()
        if pid is None:
            return []
        try:
            ps_output = subprocess.run(
                ["ps", "--ppid", str(pid), "-o", "pid=,etimes=,args="],
                capture_output=True, text=True, timeout=10).stdout
        except Exception:
            return []
    out = ps_output
    seen: dict[str, dict] = {}
    for line in out.splitlines():
        parts = line.split(None, 2)
        if len(parts) < 3:
            continue
        _child, etimes, args = parts
        key = " ".join(args.split()[:3])
        entry = seen.setdefault(key, {"command": key, "count": 0, "oldest": 0})
        entry["count"] += 1
        entry["oldest"] = max(entry["oldest"], int(etimes))
        m = re.search(r"/plugins/([a-z0-9._-]+)", args)
        if m:
            entry["plugin"] = m.group(1)
    return sorted(seen.values(), key=lambda e: -e["count"])


def cmd_helpers(args) -> int:
    helpers = helper_processes()
    if args.json:
        print(json.dumps(helpers, indent=2))
        return 0
    if not helpers:
        print("The shell has not spawned any long-lived helpers.")
        return 0
    print("\nProcesses the shell is keeping alive\n")
    for h in helpers:
        dupe = f"  \u00d7{h['count']}" if h["count"] > 1 else ""
        owner = f"  [{h['plugin']}]" if h.get("plugin") else ""
        print(f"  {h['command'][:66]}{dupe}{owner}")
    leaks = [h for h in helpers if h["count"] > 1]
    if leaks:
        print()
        print("  The duplicated ones are usually a widget that respawns its helper")
        print("  on every shell reload without stopping the old one. They cost CPU")
        print("  and memory for nothing.")
    print()
    return 0


def shell_pid() -> int | None:
    try:
        out = subprocess.run(["pgrep", "-x", "quickshell"], capture_output=True, text=True)
        pids = [int(p) for p in out.stdout.split()]
        return pids[0] if pids else None
    except Exception:
        return None


def measure_shell_cpu(seconds: int) -> float:
    system = System()
    pid = shell_pid()
    if pid is None:
        return 0.0

    def jiffies(p):
        procs = system.processes()
        return procs.get(p, ("", 0))[1]

    start = jiffies(pid)
    time.sleep(seconds)
    pid = shell_pid() or pid
    return max(0.0, (jiffies(pid) - start) / CLK_TCK)


def bar_widgets() -> list[dict]:
    """Enabled bar widgets, as candidates for quiet mode."""
    try:
        out = subprocess.run(["omarchy", "plugin", "list", "--json"],
                             capture_output=True, text=True, timeout=15).stdout
        plugins = json.loads(out or "[]")
    except Exception:
        return []
    return [p for p in plugins
            if "bar-widget" in (p.get("kinds") or []) and p.get("enabled") is not False]


def cmd_quiet(args) -> int:
    ensure_config()
    s = settings()
    plugins, commands = quiet_targets(s)

    if args.mode == "status":
        cfg = s.get("quiet", {})
        active = quiet_active()
        print(f"quiet mode: {'on' if active else 'off'}")
        if active:
            record = load_json(QUIET_MARKER, {}) or {}
            for pid in record.get("disabled", []):
                print(f"  disabled: {pid}")
            for entry in record.get("commands", []):
                print(f"  turned down: {entry.get('label') or entry.get('off')}")
        print(f"auto: {'on' if cfg.get('auto') else 'off'}"
              f" (at or below {cfg.get('belowPercent')}% on battery)")
        if plugins or commands:
            for pid in plugins:
                print(f"  will disable: {pid}")
            for entry in commands:
                print(f"  will turn down: {entry.get('label') or entry.get('off')}")
        else:
            print("  nothing configured - quiet mode has nothing to turn off")
            print("  see candidates with:  wattage quiet suggest")
        return 0

    if args.mode == "suggest":
        widgets = bar_widgets()
        if not widgets:
            print("Could not read the plugin list.")
            return 1
        print("\nBar widgets you could quieten on battery:\n")
        for w in widgets:
            print(f"  {w.get('id')}")
            if w.get("description"):
                print(f"      {w['description'][:76]}")
        print("\n  Add one with:   wattage quiet add <id>")
        print("  Measure one first:  wattage bisect <id>")
        print("\n  Whole plugins are blunt. If the cost is one setting inside a")
        print("  plugin, put its own on/off commands under quiet.commands in")
        print(f"  {SETTINGS_FILE}\n")
        return 0

    if args.mode == "add":
        known = plugin_ids()
        for pid in args.plugins:
            if known and pid not in known:
                print(f"unknown plugin id: {pid}", file=sys.stderr)
                print("see:  wattage quiet suggest", file=sys.stderr)
                return 1
            if pid not in s["quiet"]["plugins"]:
                s["quiet"]["plugins"].append(pid)
        save_settings(s)
        print("quiet plugins: " + ", ".join(s["quiet"]["plugins"]))
        return 0

    if args.mode == "remove":
        s["quiet"]["plugins"] = [p for p in s["quiet"]["plugins"] if p not in args.plugins]
        save_settings(s)
        print("quiet plugins: " + (", ".join(s["quiet"]["plugins"]) or "(none)"))
        return 0

    if args.mode == "auto":
        if not quiet_configured():
            print("Nothing is configured to quieten, so auto would do nothing.",
                  file=sys.stderr)
            print("Start with:  wattage quiet suggest", file=sys.stderr)
            return 1
        s["quiet"]["auto"] = not s["quiet"].get("auto")
        save_settings(s)
        print(f"auto quiet: {'on' if s['quiet']['auto'] else 'off'}")
        return 0

    on = args.mode == "on" if args.mode in ("on", "off") else not quiet_active()

    # Turning it "on" with nothing to turn off used to write the marker,
    # change nothing, and leave the bar icon showing quiet mode forever.
    if on and not quiet_configured():
        print("Quiet mode has nothing to turn off yet.", file=sys.stderr)
        print("", file=sys.stderr)
        print("  It disables the bar widgets you nominate while you are on", file=sys.stderr)
        print("  battery, and puts them back when you plug in. Nominate one:", file=sys.stderr)
        print("", file=sys.stderr)
        print("      wattage quiet suggest        # what you are running", file=sys.stderr)
        print("      wattage bisect <plugin-id>   # what it actually costs", file=sys.stderr)
        print("      wattage quiet add <plugin-id>", file=sys.stderr)
        print("", file=sys.stderr)
        return 1

    touched = set_quiet(on)
    print(f"quiet mode {'on' if on else 'off'}"
          + (f" ({len(touched)} restored)" if touched and not on
             else f" ({len(touched)} turned down)" if touched else ""))
    return 0


UNIT_MARK = "# managed by io.github.rr-codebase.wattage"
UNIT_DESCRIPTION = "Battery Watt Usage power attribution sampler"
# What 0.1.0 wrote, before the marker existed. Kept verbatim - old product name
# and all - because this string is compared against a file on disk, not used to
# generate one. Changing it would silently orphan every 0.1.0 unit.
LEGACY_UNIT_DESCRIPTION = "Wattage power attribution sampler"


def unit_body(cli: str, description: str) -> str:
    return f"""[Unit]
Description={description}
After=graphical-session.target

[Service]
Type=simple
ExecStart={cli} sample --daemon
Restart=on-failure
RestartSec=10
Nice=19

[Install]
WantedBy=default.target
"""


def unit_is_ours(unit: Path, cli: str) -> bool | None:
    """True if we wrote this unit, False if somebody else did, None if absent.

    `wattage.service` is a name, not a claim: the file at that path may be one
    the user wrote themselves, or a symlink they pointed at a unit of their
    own. Writing or deleting it without checking would destroy that, so it is
    opened no-follow and has to identify itself before we touch it.
    """
    try:
        st = os.lstat(unit)
    except FileNotFoundError:
        return None
    except OSError:
        return False
    if not stat.S_ISREG(st.st_mode):
        return False  # a symlink, or something stranger - not ours either way
    try:
        fd = os.open(unit, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return False
    try:
        with os.fdopen(fd, "r", errors="replace") as fh:
            text = fh.read()
    except OSError:
        return False
    if text.startswith(UNIT_MARK + "\n"):
        return True
    # 0.1.0 wrote no marker, and refusing those outright would strand everyone
    # who installed before it existed. But a resemblance is not ownership: an
    # ExecStart merely *ending* in `/bin/wattage sample --daemon` would also
    # match /opt/custom/bin/wattage, which is a different program that happens
    # to share a basename. So the file has to be exactly what 0.1.0 would have
    # written for this install, canonical CLI path included - nothing else is
    # accepted, and anything that is not is treated as somebody else's.
    return text == unit_body(cli, LEGACY_UNIT_DESCRIPTION)


def cmd_service(args) -> int:
    unit_dir = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "systemd/user"
    cli = str(PLUGIN_DIR / "bin" / "wattage")
    unit = unit_dir / "wattage.service"
    if args.action == "install":
        if unit_is_ours(unit, cli) is False:
            print(f"{unit} exists and was not written by Battery Watt Usage - leaving it alone.\n"
                  f"Move it aside and re-run if you want the sampler here.",
                  file=sys.stderr)
            return 1
        unit_dir.mkdir(parents=True, exist_ok=True)
        text = UNIT_MARK + "\n" + unit_body(cli, UNIT_DESCRIPTION)
        # Written to a fresh temporary file and renamed into place, so an
        # existing unit is replaced rather than written through and a symlink
        # there is swapped out instead of followed. The temporary name is
        # random and created O_EXCL: a predictable `wattage.service.new` could
        # be pre-created by anyone who can write to this directory, as a
        # symlink to redirect the write or a FIFO to block it. mkstemp() makes
        # a new regular file at 0600 or fails, and the descriptor is checked
        # before anything is written through it.
        fd, tmpname = tempfile.mkstemp(
            dir=unit_dir, prefix=".wattage.service.", suffix=".tmp")
        try:
            with os.fdopen(fd, "w") as fh:
                st = os.fstat(fh.fileno())
                if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
                    raise RuntimeError(f"{tmpname} is not the file we created")
                fh.write(text)
                fh.flush()
                os.fsync(fh.fileno())
            os.chmod(tmpname, 0o644)
            os.replace(tmpname, unit)
        except BaseException:
            try:
                os.unlink(tmpname)
            except OSError:
                pass
            raise
        subprocess.run(["systemctl", "--user", "daemon-reload"])
        subprocess.run(["systemctl", "--user", "enable", "--now", "wattage.service"])
        print(f"installed and started {unit}")
        return 0
    if args.action == "remove":
        owned = unit_is_ours(unit, cli)
        if owned is False:
            print(f"{unit} was not written by Battery Watt Usage - leaving it, and the "
                  f"service it controls, alone.", file=sys.stderr)
            return 1
        subprocess.run(["systemctl", "--user", "disable", "--now", "wattage.service"])
        if owned:
            unit.unlink(missing_ok=True)
        subprocess.run(["systemctl", "--user", "daemon-reload"])
        print("removed")
        return 0
    r = subprocess.run(["systemctl", "--user", "is-active", "wattage.service"],
                       capture_output=True, text=True)
    print(f"wattage.service: {r.stdout.strip() or 'not installed'}")
    return 0


def cmd_doctor(args) -> int:
    ok = True

    def check(label, good, detail=""):
        nonlocal ok
        if not good:
            ok = False
        print(f"[{'OK  ' if good else 'FAIL'}] {label}{(' - ' + detail) if detail else ''}")

    def pending(label, done, detail=""):
        """Not broken, just not observed yet. Reporting "FAIL" for something
        that only needs time on battery sends people debugging nothing."""
        print(f"[{'OK  ' if done else '....'}] {label}{(' - ' + detail) if detail else ''}")

    system = System()
    power = system.power()
    check("Battery found", bool(power["battery"]), power["battery"] or "no battery in /sys")
    check("Battery reports power", power["measured"] or not power["discharging"],
          "power_now is 0 while discharging" if power["discharging"] else
          f"on {power['status']} - draw is measurable once unplugged")
    check("Per-process CPU readable", len(system.processes()) > 10)

    rapl = Path("/sys/class/powercap/intel-rapl:0/energy_uj")
    check("RAPL (optional)", True,
          "readable" if os.access(rapl, os.R_OK) else "root-only, using battery draw instead")

    conn = db()
    n = conn.execute("SELECT COUNT(*) FROM samples").fetchone()[0]
    check("Database", True, f"{DB_FILE} ({n} samples)")

    s = settings()
    pending("Idle floor learned", float(s.get("idleWatts") or 0) > 0,
            f"{s.get('idleWatts')} W" if s.get("idleWatts")
            else "waiting for a few idle minutes on battery")
    pending("Watts per CPU-second learned", float(s.get("wattsPerCpuSecond") or 0) > 0,
            f"{s.get('wattsPerCpuSecond')} W/s" if s.get("wattsPerCpuSecond")
            else "waiting for some busy minutes on battery")

    r = subprocess.run(["systemctl", "--user", "is-active", "wattage.service"],
                       capture_output=True, text=True)
    active = r.stdout.strip() == "active"
    check("Sampler running", active, r.stdout.strip() or "run: wattage service install")

    print()
    print("Ready." if ok else "Some checks need attention - see above.")
    if ok:
        print("Lines marked .... just need time on battery; nothing to do.")
    return 0 if ok else 1


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="wattage", description="Where your battery actually goes")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("sample", help="take a sample (or run the sampler)")
    sp.add_argument("--daemon", action="store_true")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_sample)

    nw = sub.add_parser("now", help="current draw and the top consumers")
    nw.add_argument("--json", action="store_true")
    nw.set_defaults(func=cmd_now)

    tp = sub.add_parser("top", help="what used the most power over a window")
    tp.add_argument("--since", default="24h", choices=list(WINDOWS))
    tp.add_argument("--limit", type=int, default=12)
    tp.add_argument("--json", action="store_true")
    tp.set_defaults(func=cmd_top)

    bs = sub.add_parser("bisect", help="measure one bar widget by turning it off")
    bs.add_argument("plugin")
    bs.add_argument("--seconds", type=int, default=20)
    bs.set_defaults(func=cmd_bisect)

    pl = sub.add_parser("plugins", help="what each bar widget costs")
    pl.add_argument("--measure", action="store_true", help="measure them all (slow)")
    pl.add_argument("--only", nargs="*", help="limit --measure to these ids")
    pl.add_argument("--seconds", type=int, default=15)
    pl.add_argument("--yes", "-y", action="store_true")
    pl.add_argument("--json", action="store_true")
    pl.set_defaults(func=cmd_plugins)

    hp = sub.add_parser("helpers", help="processes the shell keeps alive")
    hp.add_argument("--json", action="store_true")
    hp.set_defaults(func=cmd_helpers)

    q = sub.add_parser("quiet", help="suspend expensive widgets on battery")
    q.add_argument("mode", choices=["on", "off", "toggle", "auto", "status",
                                    "add", "remove", "suggest"])
    q.add_argument("plugins", nargs="*")
    q.set_defaults(func=cmd_quiet)

    sv = sub.add_parser("service", help="the background sampler")
    sv.add_argument("action", choices=["install", "remove", "status"])
    sv.set_defaults(func=cmd_service)

    sub.add_parser("doctor", help="check the install").set_defaults(func=cmd_doctor)
    return p


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except KeyboardInterrupt:
        return 130
    except Exception as exc:
        print(f"wattage: {exc}", file=sys.stderr)
        return 3


if __name__ == "__main__":
    sys.exit(main())
